cabal-version:      3.0
name:               libpandoc
version:            0.1.0
synopsis:           pandoc as a C library
description:
  A shared library exposing pandoc through a small C ABI: conversions with
  defaults-file options or command-line arguments, and queries. See
  include/libpandoc.h.
license:            GPL-2.0-or-later
license-file:       COPYING.md
author:             Kolen Cheung
maintainer:         Kolen Cheung
copyright:          (C) 2026 Kolen Cheung
category:           Text
build-type:         Simple
extra-source-files: include/libpandoc.h
                    libpandoc.def
tested-with:        GHC == 9.10.3

common deps
  default-language: Haskell2010
  ghc-options:      -Wall
  include-dirs:     include
  build-depends:    base >= 4.18 && < 5,
                    aeson >= 2.0,
                    bytestring,
                    containers,
                    directory,
                    filepath,
                    mtl,
                    pandoc >= 3.9 && < 4,
                    pandoc-lua-engine,
                    pandoc-types >= 1.23 && < 1.24,
                    scientific,
                    skylighting,
                    temporary,
                    text

-- Everything but the exports, separate from the foreign library, whose
-- cbits refer to the exports. (Template Haskell in these modules would
-- otherwise have to link cbits, which GHC's linker can't do on Windows.)
library
  import:           deps
  hs-source-dirs:   src
  exposed-modules:  LibPandoc.Query
                    LibPandoc.Result

foreign-library pandoc
  import:           deps
  type:             native-shared
  -- wasm has no shared libraries: see the executable libpandoc-wasm
  if arch(wasm32)
    buildable:      False
  -- cabal supports library versioning only on Linux
  if os(linux)
    lib-version-info: 0:0:0
  if os(windows)
    options:        standalone
    -- only the C API: a GHC DLL exporting everything exceeds the
    -- 65535-export limit
    mod-def-file:   libpandoc.def
  hs-source-dirs:   src/flib
  build-depends:    libpandoc,
                    -- pandoc lua, as pandoc-cli
                    hslua-cli >= 1.4.1 && < 1.5
  other-modules:    LibPandoc
  c-sources:        cbits/libpandoc.c
  install-includes: libpandoc.h
  ghc-options:      -threaded

-- libpandoc.wasm: the same functions as the shared library, as a WASI
-- reactor for a wasm host (JavaScript, Pyodide, wasmtime). Built by
-- scripts/build-wasm.sh with GHC's wasm backend. No threads, no processes,
-- no `pandoc lua` REPL; a callback filter is a call to the host's import
-- libpandoc.filter (see cbits/libpandoc.c).
executable libpandoc-wasm
  import:           deps
  if !arch(wasm32)
    buildable:      False
  main-is:          Main.hs
  hs-source-dirs:   src/flib src/wasm
  build-depends:    libpandoc
  other-modules:    LibPandoc
  c-sources:        cbits/libpandoc.c
  ghc-options:      -no-hs-main -optl-mexec-model=reactor
                    "-optl-Wl,--export=malloc,--export=free,--export=pandoc_init,--export=pandoc_abi_version,--export=pandoc_convert,--export=pandoc_convert_args,--export=pandoc_convert_filters,--export=pandoc_convert_args_filters,--export=pandoc_read_many,--export=pandoc_query,--export=pandoc_result_free,--export=pandoc_buffer_set"
