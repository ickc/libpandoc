cabal-version:      3.0
name:               libpandoc
version:            0.1.0
synopsis:           pandoc as a C library
description:
  A shared library exposing pandoc through a small C ABI: conversions with
  defaults-file options or command-line arguments, and queries. See
  include/libpandoc.h.
license:            GPL-2.0-or-later
license-file:       COPYING.md
author:             Kolen Cheung
maintainer:         Kolen Cheung
copyright:          (C) 2026 Kolen Cheung
category:           Text
build-type:         Simple
extra-source-files: include/libpandoc.h
                    libpandoc.def
tested-with:        GHC == 9.10.3

common deps
  default-language: Haskell2010
  ghc-options:      -Wall
  include-dirs:     include
  build-depends:    base >= 4.18 && < 5,
                    aeson >= 2.0,
                    bytestring,
                    containers,
                    directory,
                    filepath,
                    mtl,
                    pandoc >= 3.9 && < 4,
                    pandoc-lua-engine,
                    pandoc-types >= 1.23 && < 1.24,
                    scientific,
                    skylighting,
                    temporary,
                    text

-- Everything but the exports, separate from the foreign library, whose
-- cbits refer to the exports. (Template Haskell in these modules would
-- otherwise have to link cbits, which GHC's linker can't do on Windows.)
library
  import:           deps
  hs-source-dirs:   src
  exposed-modules:  LibPandoc.Query
                    LibPandoc.Result

foreign-library pandoc
  import:           deps
  type:             native-shared
  -- cabal supports library versioning only on Linux
  if os(linux)
    lib-version-info: 0:0:0
  if os(windows)
    options:        standalone
    -- only the C API: a GHC DLL exporting everything exceeds the
    -- 65535-export limit
    mod-def-file:   libpandoc.def
  hs-source-dirs:   src/flib
  build-depends:    libpandoc
  other-modules:    LibPandoc
  c-sources:        cbits/libpandoc.c
  install-includes: libpandoc.h
  ghc-options:      -threaded
