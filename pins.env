# Everything that determines what gets built, in the same format as
# pandoc-forge/pandoc-feedstock's pins.env. CI exports these.
PANDOC_VERSION=3.14
# Hackage snapshot for dependency resolution: the time upstream published
# this release, so builds resolve what upstream could have resolved.
INDEX_STATE=2026-11-12T04:32:26Z
# Toolchain upstream used for this release (see its release workflows).
GHC_VERSION=9.10.3
# cabal: 3.14 still, though upstream's 3.14 release used 3.18.2.0: ghcup's
# aarch64 cabal 3.18 needs glibc 2.34 (manylinux_2_28 has 2.28). cabal only
# resolves the plan, which INDEX_STATE fixes; pandoc-forge keeps 3.14 too.
CABAL_VERSION=3.14.2.0
# GHC's wasm toolchain (ghc-wasm-meta) for libpandoc.wasm: the revision
# pandoc's flake.lock pins for this release, as pandoc-forge builds
# pandoc.wasm with.
GHC_WASM_META_REV=ded427a58615ce21597f945af25c778f9107e5f7
