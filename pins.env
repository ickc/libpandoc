# Everything that determines what gets built, in the same format as
# pandoc-forge/pandoc-feedstock's pins.env. CI exports these.
#
# What the build takes from outside, and how each is pinned, is listed at
# the top of .github/workflows/ci.yml. At a pandoc bump (DESIGN.md, "When
# pandoc upgrades"), besides PANDOC_VERSION and INDEX_STATE:
#   - GHC_VERSION, CABAL_VERSION: if upstream's release workflow changed
#     them; then also GHCUP_METADATA_REV (a ghcup-metadata commit that
#     lists both) and, for a new cabal, CABAL_ALPINE_AARCH64_SHA256 (the
#     sha256sum of ghcup's aarch64 Alpine tarball; that metadata's dlHash
#     for it is the same number);
#   - GHC_WASM_META_REV: as pandoc's flake.lock;
#   - cabal-wasm.project's source-repository-packages: where upstream's
#     cabal.project names a tag, libpandoc names the tag's commit (gh api
#     repos/OWNER/REPO/git/ref/tags/TAG, an annotated tag dereferenced),
#     with the tag in a comment;
#   - container images in ci.yml: by digest, the tag beside it; a newer
#     one only when wanted (how to look one up: ci.yml);
#   - actions: Dependabot proposes them weekly (.github/dependabot.yml).
PANDOC_VERSION=3.14
# Hackage snapshot for dependency resolution: the time upstream published
# this release, so builds resolve what upstream could have resolved.
INDEX_STATE=2026-11-12T04:32:26Z
# Toolchain upstream used for this release (see its release workflows).
GHC_VERSION=9.10.3
# cabal: as upstream's release workflow (and pandoc-forge). In the manylinux
# aarch64 container scripts/manylinux.sh installs ghcup's static Alpine build:
# its glibc one needs glibc 2.34 (manylinux_2_28 has 2.28).
CABAL_VERSION=3.18.2.0
CABAL_ALPINE_AARCH64_SHA256=5c3a593e5a0aec1f59b69f77ffd614cbdd1a78a9a6637501da515dd1975efc53
# ghcup, for the Linux builds (scripts/manylinux.sh): the program (the
# SHA-256s are its release's SHA256SUMS), and the commit of its metadata,
# which holds the SHA-256 of the GHC and cabal it installs.
GHCUP_VERSION=0.2.6.2
GHCUP_SHA256_X86_64=9ed5da5449b48043a0d17e767c05d2ef585e25a639bb934329496c6d2fad9cf8
GHCUP_SHA256_AARCH64=65a5f05120288ee4f1a81d28825374b6af317456a351a586adfce90c6dc29e3b
GHCUP_METADATA_REV=90d89965530e93fe8a5df1f8a2a4941674f64b00
# GHC's wasm toolchain (ghc-wasm-meta) for libpandoc.wasm: the revision
# pandoc's flake.lock pins for this release, as pandoc-forge builds
# pandoc.wasm with.
GHC_WASM_META_REV=ded427a58615ce21597f945af25c778f9107e5f7
