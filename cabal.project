packages: .

-- The Hackage snapshot and pandoc version are pinned in pins.env; CI and
-- scripts/build.sh write them to cabal.project.local.

-- From pandoc's own cabal.project (native part), so that the dependency
-- plan matches the pandoc binary's.
constraints: skylighting-format-blaze-html >= 0.1.2.2,
             skylighting-format-context >= 0.1.0.2,
             auto-update >= 0.2.6,
             crypton >= 2.0.1

package pandoc
  flags: +embed_data_files +http
